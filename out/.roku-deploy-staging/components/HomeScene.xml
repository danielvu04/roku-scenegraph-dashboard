<?xml version="1.0" encoding="utf-8"?>
<!--
  HomeScene: full-screen crossfading backgrounds, a large clock + date and a
  small weather block. The info group drifts slowly to avoid burn-in.
-->
<component name="HomeScene" extends="Scene">
    <interface>
        <!-- main.brs observes this and closes the screen (exits the channel) -->
        <field id="exitRequested" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="pkg:/source/generated_config.brs" />
    <script type="text/brightscript" uri="pkg:/components/HomeScene.brs" />

    <children>
        <Rectangle id="base" width="1920" height="1080" color="0x0B0B0DFF" />

        <!-- Two stacked posters: bgB fades in/out over bgA -->
        <Poster id="bgA" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" />
        <Poster id="bgB" width="1920" height="1080" loadWidth="1920" loadHeight="1080" loadDisplayMode="scaleToZoom" opacity="0" />

        <!-- Soft dark vignette for text legibility on any background -->
        <Poster id="scrim" uri="pkg:/images/scrim.png" width="1920" height="1080" loadDisplayMode="scaleToFill" />

        <Group id="info" translation="[160, 340]">
            <Label id="clockShadow" translation="[5, 6]" color="0x00000040">
                <Font role="font" uri="pkg:/fonts/InterDisplay-SemiBold.otf" size="190" />
            </Label>
            <Label id="clock" color="0xFFFFFFFF">
                <Font role="font" uri="pkg:/fonts/InterDisplay-SemiBold.otf" size="190" />
            </Label>

            <Label id="ampmShadow" translation="[3, 34]" color="0x00000040">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="60" />
            </Label>
            <Label id="ampm" translation="[0, 30]" color="0xEBEBF599">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="60" />
            </Label>

            <Label id="dateShadow" translation="[3, 233]" color="0x00000040">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="58" />
            </Label>
            <Label id="date" translation="[0, 230]" color="0xEBEBF5CC">
                <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="58" />
            </Label>

            <!-- Hidden until the first successful fetch; hidden again if data goes stale -->
            <Group id="weather" translation="[44, 372]" visible="false">
                <!-- rounded translucent panel behind the weather block (drawn first) -->
                <Poster id="wxCard" uri="pkg:/images/card.png" translation="[-44, -40]" width="600" height="300" loadDisplayMode="scaleToFill" />
                <Poster id="wxIcon" width="112" height="112" loadDisplayMode="scaleToFit" />

                <Label id="tempShadow" translation="[137, 8]" color="0x00000040">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-SemiBold.otf" size="92" />
                </Label>
                <Label id="temp" translation="[134, 5]" color="0xFFFFFFFF">
                    <Font role="font" uri="pkg:/fonts/InterDisplay-SemiBold.otf" size="92" />
                </Label>

                <Label id="wxTextShadow" translation="[3, 133]" color="0x00000040">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="44" />
                </Label>
                <Label id="wxText" translation="[0, 130]" color="0xFFFFFFFF">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="44" />
                </Label>

                <Label id="placeShadow" translation="[3, 191]" color="0x00000040">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="34" />
                </Label>
                <Label id="place" translation="[0, 188]" color="0xEBEBF599">
                    <Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="34" />
                </Label>
            </Group>
        </Group>

        <!-- Bottom-right app row: Down enters, Left/Right move, OK opens; only the focused tile shows its name -->
        <Group id="appList" translation="[1044, 860]" visible="false">
            <Group id="tile0" translation="[0, 0]">
                <Rectangle id="tileRing0" translation="[-4, -4]" width="188" height="118" color="0xFFFFFFFF" visible="false" />
                <Rectangle id="tileBg0" width="180" height="110" color="0x1C1C1EB3" />
                <Label id="tileLabel0" width="180" height="110" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="28" />
                </Label>
            </Group>
            <Group id="tile1" translation="[200, 0]">
                <Rectangle id="tileRing1" translation="[-4, -4]" width="188" height="118" color="0xFFFFFFFF" visible="false" />
                <Rectangle id="tileBg1" width="180" height="110" color="0x1C1C1EB3" />
                <Label id="tileLabel1" width="180" height="110" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="28" />
                </Label>
            </Group>
            <Group id="tile2" translation="[400, 0]">
                <Rectangle id="tileRing2" translation="[-4, -4]" width="188" height="118" color="0xFFFFFFFF" visible="false" />
                <Rectangle id="tileBg2" width="180" height="110" color="0x1C1C1EB3" />
                <Label id="tileLabel2" width="180" height="110" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="28" />
                </Label>
            </Group>
            <Group id="tile3" translation="[600, 0]">
                <Rectangle id="tileRing3" translation="[-4, -4]" width="188" height="118" color="0xFFFFFFFF" visible="false" />
                <Rectangle id="tileBg3" width="180" height="110" color="0x1C1C1EB3" />
                <Label id="tileLabel3" width="180" height="110" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false">
                    <Font role="font" uri="pkg:/fonts/Inter-Medium.otf" size="28" />
                </Label>
            </Group>
        </Group>

        <!-- Idle dim: opacity goes up after 10 minutes, any key wakes the screen -->
        <Rectangle id="dimOverlay" width="1920" height="1080" color="0x000000FF" opacity="0" />

        <Animation id="fadeAnim" duration="2.5" easeFunction="inOutCubic" repeat="false">
            <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="bgB.opacity" />
        </Animation>

        <Animation id="driftAnim" duration="12" easeFunction="inOutQuad" repeat="false">
            <Vector2DFieldInterpolator id="driftInterp" key="[0.0, 1.0]" keyValue="[[160, 340], [160, 340]]" fieldToInterp="info.translation" />
        </Animation>

        <Timer id="clockTimer" repeat="true" duration="1" />
        <Timer id="bgTimer" repeat="true" duration="45" />
        <Timer id="bgLoadTimeout" repeat="false" duration="5" />
        <Timer id="driftTimer" repeat="true" duration="180" />
        <Timer id="sleepTimer" repeat="false" duration="600" />
        <Timer id="weatherTimer" repeat="false" duration="900" />
    </children>
</component>
